        <mxCell id="R6Mr8nXAsvR23UtDhqNH-32" value="&lt;b&gt;Portfoliomoment&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* Toont zijn verzamelde bewijs in PortFlow aan de docenten (4-ogen principe)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* Ook (eventuele) vorig actieplan wordt besproken&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Schrijft feedback op voor zijn nieuwe actieplan&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="110" y="760" width="490" height="110" as="geometry" />
        </mxCell>
        <mxCell id="R6Mr8nXAsvR23UtDhqNH-34" value="Docent" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" parent="1" vertex="1">
