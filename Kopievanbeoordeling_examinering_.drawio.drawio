        <mxCell id="R6Mr8nXAsvR23UtDhqNH-32" value="&lt;b&gt;Portfoliomoment&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Initiatief ligt bij de student&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;* Staaft zijn actieplan bij de docent&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;* Ook (eventuele) vorig actieplan wordt besproken&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Past zijn actieplan aan tijdens het gesprek&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Docent vult Magister definitief in&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
